# Application Settings
APP_ENV=development
SECRET_KEY=tara-super-secret-jwt-key-replace-in-production-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tara

# Seed Configuration
SEED_PASSWORD=ChangeMe123!
SEED_TEST_PHONE_1=
SEED_TEST_PHONE_2=
SEED_TEST_PHONE_3=

# Voice Pipeline Selection (twilio_gnani)
VOICE_PROVIDER=twilio_gnani
VOICE_DEFAULT_LANGUAGE=hi-IN

# Twilio Telephony Configuration (TARA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gnani Voice AI Configuration (TARA)
GNANI_API_KEY=
GNANI_PRISMA_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_VOICE=Nalini

# Groq LLM Inference (TARA)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq

# Compliance & Safety Configuration
TEST_MODE=true
TEST_ALLOWLIST=
COMPLIANCE_EXEMPT_NUMBERS=
COMPLIANCE_CHECK_DUPLICATE_IN_FLIGHT=true
COMPLIANCE_CHECK_FREQUENCY_CAP=true
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00
CONTACT_CAP_COUNT=2
CONTACT_CAP_DAYS=7

# Public URL (use your cloudflared/ngrok tunnel URL here for Twilio webhooks and media streams)
PUBLIC_BASE_URL=http://localhost:8000

# Campaign Execution Configuration
CAMPAIGN_MAX_RECIPIENTS=200
CAMPAIGN_MAX_CONCURRENT=2
CAMPAIGN_DISPATCH_DELAY_SECONDS=5
