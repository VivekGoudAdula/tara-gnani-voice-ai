# Git ignore rules for TARA 2.0 (Gnani Voice AI)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Virtual environments
.venv
venv/
env/
backend/venv/
backend/.venv/

# Python byte code & caches
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Frontend build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.next/
*.tsbuildinfo

# OS & IDE temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
.gemini/
.cursor/
*.swp
*.swo

# Scratch, temp, logs and test artifacts
scratch/
*.tmp
*.temp
*temp*.csv
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
playwright-report/
test-results/
blob-report/
